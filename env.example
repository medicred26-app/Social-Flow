# SocialFlow environment templates
# Copy frontend section → frontend/.env.local
# Copy backend section → backend/.env

# ========== FRONTEND (frontend/.env.local) ==========
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ========== BACKEND (backend/.env) ==========
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:4000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
ENABLE_INLINE_SCHEDULER=true
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth callback URLs (register in each developer portal):
# http://localhost:3001/api/oauth/{facebook|instagram|linkedin|x|youtube}/callback
